<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource AppTitle}" Width="420" Height="380" MinWidth="420" MinHeight="380"
        MaxWidth="820" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" FontFamily="{DynamicResource InterfaceFont}" FontSize="{DynamicResource BodySize}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <FontFamily x:Key="InterfaceFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="BodySize">14</sys:Double>
    <sys:Double x:Key="HeadingSize">16</sys:Double>
    <Geometry x:Key="ChineseLanguageIcon">M 11,3 L 13,6 M 3,8 H 21 M 7.5,8 C 9,14 14,18.5 21,21 M 16.5,8 C 15,14 10,18.5 3,21</Geometry>
    <Geometry x:Key="EnglishLanguageIcon">M 4,21 L 12,3 20,21 M 7,15 H 17</Geometry>
    <Geometry x:Key="UpdateIcon">M 12,3 V 15 M 7,10 L 12,15 17,10 M 4,16 V 20 H 20 V 16</Geometry>
    <Geometry x:Key="FolderIcon">M 3,20 H 19 Q 21,20 21,18 V 8 Q 21,6 19,6 H 11 L 9,4 H 5 Q 3,4 3,6 Z M 3,9 H 21</Geometry>
    <Geometry x:Key="MoonIcon">M 20.6,15.4 A 9,9 0 0 1 8.6,3.4 A 9,9 0 1 0 20.6,15.4 Z</Geometry>
    <Geometry x:Key="SunIcon">M 16,12 A 4,4 0 1 0 8,12 A 4,4 0 1 0 16,12 Z M 12,2 L 12,4 M 12,20 L 12,22 M 2,12 L 4,12 M 20,12 L 22,12 M 5,5 L 6.5,6.5 M 17.5,17.5 L 19,19 M 19,5 L 17.5,6.5 M 6.5,17.5 L 5,19</Geometry>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="{StaticResource HeadingSize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
      <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
      <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
    </Style>
    <Style x:Key="FocusCue">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="{DynamicResource Focus}" BorderThickness="2" CornerRadius="5" Margin="4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ButtonLabel">
      <TextBlock Text="{Binding}" TextAlignment="Center"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
    </DataTemplate>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="ContentTemplate" Value="{StaticResource ButtonLabel}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"
                      Margin="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="ButtonHighlight" Margin="1" BorderBrush="{DynamicResource Focus}"
                      BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonHighlight" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/>
                <Setter TargetName="ButtonHighlight" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                <Setter Property="Background" Value="{DynamicResource Canvas}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Track}"/>
                <Setter TargetName="ButtonHighlight" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="ContentTemplate" Value="{x:Null}"/>
    </Style>
    <Style x:Key="ToolbarGlyph" TargetType="Path">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Track}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                      Background="{TemplateBinding Foreground}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PageScrollButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="24,14,24,10" MaxWidth="650">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="UpdateButton" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0">
          <Path Style="{StaticResource ToolbarGlyph}" Data="{StaticResource UpdateIcon}"/>
        </Button>
        <Button x:Name="ThemeButton" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0">
          <Path x:Name="ThemeGlyph" Style="{StaticResource ToolbarGlyph}"/>
        </Button>
        <Button x:Name="LanguageButton" Style="{StaticResource ToolbarButton}"
                ToolTip="{DynamicResource LanguageSwitch}" AutomationProperties.Name="{DynamicResource LanguageSwitch}">
          <Path x:Name="LanguageGlyph" Style="{StaticResource ToolbarGlyph}"/>
        </Button>
      </StackPanel>
    </Grid>
  <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Background="{DynamicResource Canvas}">
    <ScrollViewer.Resources>
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{DynamicResource Canvas}">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PageScrollButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="{DynamicResource Border}" Margin="3,2" CornerRadius="3"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PageScrollButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ScrollViewer.Resources>
    <StackPanel Margin="24,0,24,8" MaxWidth="650">
        <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="14,8">
          <StackPanel>
            <TextBlock x:Name="StateTitle" Style="{StaticResource SectionHeading}" Text="{DynamicResource Checking}"/>
            <TextBlock x:Name="StateDetail" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                       LineHeight="20"/>
            <Grid x:Name="ProgressRow" Margin="0,6,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ProgressBar x:Name="Progress" Style="{StaticResource ProgressStyle}" Minimum="0" Maximum="100"
                           AutomationProperties.Name="{DynamicResource UpdateProgress}"/>
              <TextBlock x:Name="ProgressText" Grid.Column="1" Text="" Foreground="{DynamicResource Muted}"
                         Margin="10,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,8,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource InstallLocation}" Style="{StaticResource SectionHeading}"/>
                <TextBlock x:Name="InstallPath" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/>
              </StackPanel>
              <Button x:Name="ManualPathButton" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                      Style="{StaticResource ToolbarButton}" Width="38" MinHeight="38" Padding="6">
                <Button.ContextMenu>
                  <ContextMenu Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}"
                               BorderBrush="{DynamicResource Border}">
                    <MenuItem x:Name="AutoPathItem" Header="{DynamicResource AutoDetect}"/>
                  </ContextMenu>
                </Button.ContextMenu>
                <Path Style="{StaticResource ToolbarGlyph}" Data="{StaticResource FolderIcon}"/>
              </Button>
            </Grid>
            <TextBlock x:Name="SettingsFeedback" Visibility="Collapsed" Text="{DynamicResource PrefsFailure}"
                       Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>
    <Grid Grid.Row="2" Margin="24,8,24,14" MaxWidth="650">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="StartButton" IsDefault="True" Style="{StaticResource ActionButton}" Content="{DynamicResource Start}"/>
      <Button x:Name="RestoreButton" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
              Content="{DynamicResource Restore}"/>
    </Grid>
  </Grid>
</Window>
