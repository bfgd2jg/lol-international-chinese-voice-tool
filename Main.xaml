<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Width="420" Height="470" MinWidth="420" MinHeight="470"
        MaxWidth="820" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Geometry x:Key="GearIcon">M 10,2.5 L 14,2.5 14.7,5.2 16.4,6.2 19.1,5.5 21.1,9 19.2,11 19.2,13 21.1,15 19.1,18.5 16.4,17.8 14.7,18.8 14,21.5 10,21.5 9.3,18.8 7.6,17.8 4.9,18.5 2.9,15 4.8,13 4.8,11 2.9,9 4.9,5.5 7.6,6.2 9.3,5.2 Z M 15,12 A 3,3 0 1 0 9,12 A 3,3 0 1 0 15,12 Z</Geometry>
    <Geometry x:Key="MoonIcon">M 20.6,15.4 A 9,9 0 0 1 8.6,3.4 A 9,9 0 1 0 20.6,15.4 Z</Geometry>
    <Geometry x:Key="SunIcon">M 16,12 A 4,4 0 1 0 8,12 A 4,4 0 1 0 16,12 Z M 12,2 L 12,4 M 12,20 L 12,22 M 2,12 L 4,12 M 20,12 L 22,12 M 5,5 L 6.5,6.5 M 17.5,17.5 L 19,19 M 19,5 L 17.5,6.5 M 6.5,17.5 L 5,19</Geometry>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FocusCue">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="{DynamicResource Focus}" BorderThickness="2" CornerRadius="5" Margin="4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ButtonLabel">
      <TextBlock Text="{Binding}" TextAlignment="Center"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
    </DataTemplate>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="ContentTemplate" Value="{StaticResource ButtonLabel}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"
                      Margin="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="ButtonHighlight" Margin="1" BorderBrush="{DynamicResource Focus}"
                      BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonHighlight" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/>
                <Setter TargetName="ButtonHighlight" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                <Setter Property="Background" Value="{DynamicResource Canvas}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Track}"/>
                <Setter TargetName="ButtonHighlight" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="ContentTemplate" Value="{x:Null}"/>
    </Style>
    <Style x:Key="ToolbarGlyph" TargetType="Path">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="ContentTemplate" Value="{StaticResource ButtonLabel}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="1" Padding="6,3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="ChoiceHighlight" Margin="1" BorderBrush="{DynamicResource Focus}" BorderThickness="2"
                      CornerRadius="7" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChoiceHighlight" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selected}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectedInk}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Focus}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="ChoiceHighlight" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Track}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                      Background="{TemplateBinding Foreground}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PageScrollButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="24,14,24,10" MaxWidth="650">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource Brand}" FontSize="15" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="ThemeButton" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0">
          <Button.ContextMenu>
            <ContextMenu Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}"
                         BorderBrush="{DynamicResource Border}">
              <MenuItem x:Name="SystemThemeItem" Header="{DynamicResource ThemeSystem}"/>
            </ContextMenu>
          </Button.ContextMenu>
          <Path x:Name="ThemeGlyph" Style="{StaticResource ToolbarGlyph}"/>
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}"
                ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}">
          <Path Style="{StaticResource ToolbarGlyph}" Data="{StaticResource GearIcon}"/>
        </Button>
      </StackPanel>
    </Grid>
  <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Background="{DynamicResource Canvas}">
    <ScrollViewer.Resources>
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{DynamicResource Canvas}">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PageScrollButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="{DynamicResource Border}" Margin="3,2" CornerRadius="3"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PageScrollButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ScrollViewer.Resources>
    <StackPanel Margin="24,0,24,8" MaxWidth="650">
        <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="14,8">
          <StackPanel>
            <TextBlock x:Name="StateTitle" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource Checking}"/>
            <TextBlock x:Name="StateDetail" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                       LineHeight="20"/>
            <Grid x:Name="ProgressRow" Margin="0,6,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ProgressBar x:Name="Progress" Style="{StaticResource ProgressStyle}" Minimum="0" Maximum="100"
                           AutomationProperties.Name="{DynamicResource UpdateProgress}"/>
              <TextBlock x:Name="ProgressText" Grid.Column="1" Text="" Foreground="{DynamicResource Muted}"
                         FontSize="12" Margin="10,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="StartButton" IsDefault="True" Style="{StaticResource ActionButton}" Content="{DynamicResource Start}"/>
          <Button x:Name="RestoreButton" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                  Content="{DynamicResource Restore}"/>
        </Grid>
        <Border x:Name="SettingsPanel" Style="{StaticResource Card}" Padding="14,8" Margin="0,8,0,0"
                AutomationProperties.Name="{DynamicResource Settings}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource UiLanguage}" FontWeight="SemiBold"/>
              <TextBlock x:Name="SettingsFeedback" Grid.Column="1" Visibility="Collapsed" TextAlignment="Right"
                         Foreground="{DynamicResource Muted}" FontSize="13" Margin="8,0,0,0"/>
            </Grid>
            <UniformGrid Columns="2" Margin="0,6,0,0">
              <RadioButton x:Name="UiChinese" GroupName="UiLanguage" Content="简体中文" Style="{StaticResource Choice}"/>
              <RadioButton x:Name="UiEnglish" GroupName="UiLanguage" Content="English" Style="{StaticResource Choice}" Margin="8,0,0,0"/>
            </UniformGrid>
            <TextBlock Text="{DynamicResource InstallLocation}" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBlock x:Name="InstallPath" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="AutoPathButton" Content="{DynamicResource AutoDetect}" Style="{StaticResource SecondaryButton}"/>
              <Button x:Name="ManualPathButton" Grid.Column="2" Content="{DynamicResource ChoosePath}" Style="{StaticResource SecondaryButton}"/>
            </Grid>
          </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</Window>
