<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Width="620" Height="570" MinWidth="420" MinHeight="470"
        MaxWidth="820" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FocusCue">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="{DynamicResource Focus}" BorderThickness="2" CornerRadius="5" Margin="4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"
                      Margin="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.94"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                <Setter Property="Background" Value="{DynamicResource Canvas}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Track}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6,3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Focus}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selected}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectedInk}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Focus}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Track}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                      Background="{TemplateBinding Foreground}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PageScrollButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="24,18,24,14" MaxWidth="650">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource Brand}" FontSize="15" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Grid Grid.Column="1">
        <Button x:Name="SettingsButton" Content="{DynamicResource Settings}" Style="{StaticResource SecondaryButton}" MinWidth="68"/>
        <Button x:Name="BackButton" Content="{DynamicResource Back}" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
      </Grid>
    </Grid>
  <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Background="{DynamicResource Canvas}">
    <ScrollViewer.Resources>
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{DynamicResource Canvas}">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PageScrollButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="{DynamicResource Border}" Margin="3,2" CornerRadius="3"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PageScrollButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ScrollViewer.Resources>
    <StackPanel Margin="24,0,24,24" MaxWidth="650">
      <StackPanel x:Name="HomePanel">
        <Border Padding="20,17" CornerRadius="10" Background="{DynamicResource Hero}"
                BorderThickness="1" BorderBrush="{DynamicResource Hero}">
          <StackPanel>
            <TextBlock Text="{DynamicResource HeroTitle}" Foreground="{DynamicResource HeroInk}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource HeroDetail}" Foreground="{DynamicResource HeroMuted}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" MinHeight="116">
          <StackPanel>
            <TextBlock x:Name="StateTitle" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource Checking}"/>
            <TextBlock x:Name="StateDetail" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"
                       MinHeight="40" LineHeight="20"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ProgressBar x:Name="Progress" Style="{StaticResource ProgressStyle}" Minimum="0" Maximum="100"
                           AutomationProperties.Name="{DynamicResource UpdateProgress}" Visibility="Hidden"/>
              <TextBlock x:Name="ProgressText" Grid.Column="1" Text="" Foreground="{DynamicResource Muted}"
                         FontSize="12" Margin="10,0,0,0" Visibility="Hidden"/>
            </Grid>
          </StackPanel>
        </Border>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="StartButton" IsDefault="True" Style="{StaticResource ActionButton}" Content="{DynamicResource Start}"/>
          <Button x:Name="RestoreButton" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                  Content="{DynamicResource Restore}"/>
        </Grid>
        <TextBlock Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,12,0,0" LineHeight="20"
                   Text="{DynamicResource Footnote}"/>
      </StackPanel>
      <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
        <TextBlock Text="{DynamicResource Settings}" FontSize="25" FontWeight="SemiBold" Margin="0,1,0,12"/>
        <Border Style="{StaticResource Card}" Padding="16,10">
          <StackPanel>
            <TextBlock Text="{DynamicResource Theme}" FontWeight="SemiBold"/>
            <UniformGrid Columns="3" Margin="0,8,0,0">
              <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="{DynamicResource ThemeSystem}" Tag="System" Style="{StaticResource Choice}"/>
              <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="{DynamicResource ThemeLight}" Tag="Light" Style="{StaticResource Choice}" Margin="8,0,0,0"/>
              <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="{DynamicResource ThemeDark}" Tag="Dark" Style="{StaticResource Choice}" Margin="8,0,0,0"/>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource UiLanguage}" FontWeight="SemiBold"/>
            <UniformGrid Columns="2" Margin="0,8,0,0">
              <RadioButton x:Name="UiChinese" GroupName="UiLanguage" Content="简体中文" Style="{StaticResource Choice}"/>
              <RadioButton x:Name="UiEnglish" GroupName="UiLanguage" Content="English" Style="{StaticResource Choice}" Margin="8,0,0,0"/>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource InstallLocation}" FontWeight="SemiBold"/>
            <TextBlock x:Name="InstallPath" Margin="0,6,0,0" Foreground="{DynamicResource Muted}"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="AutoPathButton" Content="{DynamicResource AutoDetect}" Style="{StaticResource SecondaryButton}"/>
              <Button x:Name="ManualPathButton" Grid.Column="2" Content="{DynamicResource ChoosePath}" Style="{StaticResource SecondaryButton}"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource LaunchMode}" FontWeight="SemiBold"/>
            <UniformGrid Columns="2" Margin="0,8,0,0">
              <RadioButton x:Name="LaunchAuto" GroupName="Launch" Content="{DynamicResource AutoLaunch}" Style="{StaticResource Choice}"/>
              <RadioButton x:Name="LaunchManual" GroupName="Launch" Content="{DynamicResource ManualLaunch}" Style="{StaticResource Choice}" Margin="8,0,0,0"/>
            </UniformGrid>
          </StackPanel>
        </Border>
        <TextBlock x:Name="SettingsFeedback" Text="{DynamicResource PrefsHint}"
                   Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,10,0,0"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</Window>
